### Modern JavaScript Patterns & ES2023+ Features
```javascript
// Private fields and methods
class UserService {
  #apiClient
  #cache = new Map()
  
  constructor(apiClient) {
    this.#apiClient = apiClient
  }
  
  // Public method
  async getUser(id) {
    return this.#cache.get(id) ?? await this.#fetchUser(id)
  }
  
  // Private method
  async #fetchUser(id) {
    const user = await this.#apiClient.get(`/users/${id}`)
    this.#cache.set(id, user)
    return user
  }
}

// Advanced destructuring and optional chaining
const processApiResponse = (response) => {
  const {
    data: {
      users = [],
      meta: { total = 0, page = 1 } = {},
      ...restData
    } = {},
    errors = null
  } = response ?? {}
  
  // Nullish coalescing and optional chaining
  const activeUsers = users
    .filter(user => user?.status === 'active')
    .map(({ id, name, email, profile = {} }) => ({
      id,
      name,
      email,
      avatar: profile?.avatar?.url ?? '/default-avatar.png',
      lastSeen: profile?.lastSeen?.toISOString?.() ?? null
    }))
  
  return { activeUsers, total, page, errors }
}

// Functional composition and currying
const pipe = (...fns) => (value) => fns.reduce((acc, fn) => fn(acc), value)
const curry = (fn) => (...args) => 
  args.length >= fn.length ? fn(...args) : curry(fn.bind(null, ...args))

const validateField = curry((rules, value) => 
  rules.every(rule => rule(value))
)

const required = (value) => value != null && value !== ''
const minLength = (min) => (value) => value?.length >= min
const isEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)

// Usage
const validateEmail = validateField([required, isEmail])
const validatePassword = validateField([required, minLength(8)])

const processUserForm = pipe(
  (formData) => Object.fromEntries(new FormData(formData)),
  (data) => ({
    ...data,
    emailValid: validateEmail(data.email),
    passwordValid: validatePassword(data.password)
  }),
  (data) => data.emailValid && data.passwordValid ? data : null
)
