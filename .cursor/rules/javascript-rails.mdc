### Testing Patterns for JavaScript
```javascript
// Test utilities for Stimulus controllers
export class StimulusTestUtils {
  static async createController(ControllerClass, html = '', values = {}) {
    const fixture = document.createElement('div')
    fixture.innerHTML = html
    document.body.appendChild(fixture)
    
    const element = fixture.firstElementChild || fixture
    
    // Set values
    Object.entries(values).forEach(([key, value]) => {
      element.dataset[`${ControllerClass.identifier}${key.charAt(0).toUpperCase() + key.slice(1)}Value`] = 
        typeof value === 'object' ? JSON.stringify(value) : value
    })
    
    const application = Application.start()
    application.register(ControllerClass.identifier, ControllerClass)
    
    await new Promise(resolve => setTimeout(resolve, 0)) // Wait for connection
    
    const controller = application.getControllerForElementAndIdentifier(element, ControllerClass.identifier)
    
    return {
      controller,
      element,
      cleanup: () => {
        application.stop()
        document.body.removeChild(fixture)
      }
    }
  }
}

// Example test
describe('FormController', () => {
  let controller, element, cleanup
  
  beforeEach(async () => {
    const setup = await StimulusTestUtils.createController(
      FormController,
      '<form data-controller="form"><input type="text" name="name"></form>',
      { url: '/api/submit' }
    )
    
    controller = setup.controller
    element = setup.element
    cleanup = setup.cleanup
  })
  
  afterEach(() => {
    cleanup()
  })
  
  it('validates form input', async () => {
    const input = element.querySelector('input')
    input.value = 'test'
    input.dispatchEvent(new Event('input'))
    
    // Wait for debounced validation
    await new Promise(resolve => setTimeout(resolve, 400))
    
    expect(controller.isFormValid()).toBe(true)
  })
})
