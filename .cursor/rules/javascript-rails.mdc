### Performance Optimization & Memory Management
```javascript
// Efficient DOM operations with caching
class DOMManager {
  #cache = new WeakMap()
  #observer = new IntersectionObserver(this.#handleIntersection.bind(this))
  
  queryCached(selector, context = document) {
    if (!this.#cache.has(context)) {
      this.#cache.set(context, new Map())
    }
    
    const contextCache = this.#cache.get(context)
    if (!contextCache.has(selector)) {
      contextCache.set(selector, context.querySelector(selector))
    }
    
    return contextCache.get(selector)
  }
  
  // Virtualized list for large datasets
  createVirtualList(container, items, renderItem, itemHeight = 50) {
    const visibleCount = Math.ceil(container.clientHeight / itemHeight)
    let startIndex = 0
    
    const render = () => {
      const endIndex = Math.min(startIndex + visibleCount, items.length)
      const fragment = document.createDocumentFragment()
      
      for (let i = startIndex; i < endIndex; i++) {
        const item = renderItem(items[i], i)
        fragment.appendChild(item)
      }
      
      container.innerHTML = ''
      container.appendChild(fragment)
    }
    
    const handleScroll = this.throttle(() => {
      startIndex = Math.floor(container.scrollTop / itemHeight)
      render()
    }, 16) // 60fps
    
    container.addEventListener('scroll', handleScroll, { passive: true })
    render()
    
    return () => container.removeEventListener('scroll', handleScroll)
  }
  
  throttle(func, limit) {
    let inThrottle
    return (...args) => {
      if (!inThrottle) {
        func.apply(this, args)
        inThrottle = true
        setTimeout(() => inThrottle = false, limit)
      }
    }
  }
}

// Advanced async patterns with proper error handling
class AsyncOperationManager {
  #operations = new Map()
  
  async withRetry(operation, maxRetries = 3, backoffMs = 1000) {
    let lastError
    
    for (let attempt = 0; attempt <= maxRetries; attempt++) {
      try {
        return await operation()
      } catch (error) {
        lastError = error
        
        if (attempt < maxRetries) {
          const delay = backoffMs * Math.pow(2, attempt)
          await new Promise(resolve => setTimeout(resolve, delay))
        }
      }
    }
    
    throw lastError
  }
  
  async withTimeout(operation, timeoutMs = 5000) {
    const timeout = new Promise((_, reject) =>
      setTimeout(() => reject(new Error('Operation timed out')), timeoutMs)
    )
    
    return Promise.race([operation(), timeout])
  }
  
  // Circuit breaker pattern
  createCircuitBreaker(operation, threshold = 5, resetTimeMs = 60000) {
    let failures = 0
    let isOpen = false
    let nextAttempt = Date.now()
    
    return async (...args) => {
      if (isOpen && Date.now() < nextAttempt) {
        throw new Error('Circuit breaker is open')
      }
      
      try {
        const result = await operation(...args)
        failures = 0
        isOpen = false
        return result
      } catch (error) {
        failures++
        
        if (failures >= threshold) {
          isOpen = true
          nextAttempt = Date.now() + resetTimeMs
        }
        
        throw error
      }
    }
  }
}
