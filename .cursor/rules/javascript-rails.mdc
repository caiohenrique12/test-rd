### Expert Stimulus Controller with Inheritance & Mixins
```javascript
import { Controller } from "@hotwired/stimulus"

// Base controller with common functionality
class BaseController extends Controller {
  #abortController = new AbortController()
  #observers = new Set()

  connect() {
    this.setupErrorBoundary()
    this.initializeController()
  }

  disconnect() {
    this.cleanup()
  }

  // Template method pattern
  initializeController() {
    // Override in subclasses
  }

  // Private method for cleanup
  cleanup() {
    this.#abortController.abort()
    this.#observers.forEach(observer => observer.disconnect())
    this.#observers.clear()
  }

  // Error boundary
  setupErrorBoundary() {
    window.addEventListener('error', this.handleGlobalError.bind(this), {
      signal: this.#abortController.signal
    })
  }

  handleGlobalError(event) {
    console.error('Controller error:', event.error)
    this.notifyError?.(event.error)
  }

  // Utility for safe DOM operations
  safeQuerySelector(selector, context = this.element) {
    const element = context?.querySelector(selector)
    if (!element) {
      console.warn(`Element not found: ${selector}`)
    }
    return element
  }
}

// Mixin for API functionality
const ApiMixin = {
  async makeRequest(url, options = {}) {
    const { timeout = 5000, retries = 3, ...fetchOptions } = options
    
    const controller = new AbortController()
    const timeoutId = setTimeout(() => controller.abort(), timeout)
    
    try {
      const response = await this.retryOperation(
        () => fetch(url, {
          ...fetchOptions,
          signal: controller.signal,
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': this.csrfToken,
            ...fetchOptions.headers
          }
        }),
        retries
      )
      
      clearTimeout(timeoutId)
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`)
      }
      
      return await response.json()
    } catch (error) {
      clearTimeout(timeoutId)
      this.handleApiError(error)
      throw error
    }
  },

  async retryOperation(operation, retries, delay = 1000) {
    for (let i = 0; i <= retries; i++) {
      try {
        return await operation()
      } catch (error) {
        if (i === retries) throw error
        await new Promise(resolve => setTimeout(resolve, delay * Math.pow(2, i)))
      }
    }
  },

  get csrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.content ?? ''
  }
}

// Advanced controller using inheritance and mixins
export default class FormController extends BaseController {
  static targets = ["form", "submit", "errors"]
  static classes = ["loading", "error", "success", "disabled"]
  static values = { 
    url: String,
    method: { type: String, default: "POST" },
    timeout: { type: Number, default: 10000 },
    debounceTime: { type: Number, default: 300 }
  }

  initialize() {
    // Mixin composition
    Object.assign(this, ApiMixin)
    this.debouncedValidate = this.debounce(this.validateForm.bind(this), this.debounceTimeValue)
  }

  initializeController() {
    this.setupFormValidation()
    this.setupAutoSave()
  }

  setupFormValidation() {
    this.formTarget.addEventListener('input', this.debouncedValidate, {
      passive: true
    })
  }

  async submit(event) {
    event.preventDefault()
    
    if (!this.isFormValid()) return
    
    const formData = new FormData(this.formTarget)
    const data = Object.fromEntries(formData.entries())
    
    try {
      this.setLoadingState(true)
      const result = await this.makeRequest(this.urlValue, {
        method: this.methodValue,
        body: JSON.stringify(data),
        timeout: this.timeoutValue
      })
      
      await this.handleSuccess(result)
    } catch (error) {
      this.handleError(error)
    } finally {
      this.setLoadingState(false)
    }
  }

  // Advanced utility methods
  debounce(func, wait) {
    let timeout
    return (...args) => {
      clearTimeout(timeout)
      timeout = setTimeout(() => func.apply(this, args), wait)
    }
  }

  setLoadingState(loading) {
    this.element.classList.toggle(this.loadingClass, loading)
    this.submitTarget.disabled = loading
  }
}
