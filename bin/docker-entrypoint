#!/bin/bash -e

# A restarted container must not reuse a pid from the previous process.
rm -f tmp/pids/server.pid

# Development installs gems into the image bundle path, which survives the
# source bind mount. Production gems are already installed in the image.
if [ "${RAILS_ENV}" != "production" ]; then
  bundle check || bundle install
fi

for arg in "$@"; do
  if [ "${arg}" = "rspec" ] || [ "${arg}" = "test" ] || [ "${arg}" = "cucumber" ]; then
    RAILS_ENV=test ./bin/rails db:prepare
    break
  fi

  if [ "${arg}" = "server" ]; then
    ./bin/rails db:prepare
    RAILS_ENV=test ./bin/rails db:prepare
    break
  fi
done

exec "$@"
