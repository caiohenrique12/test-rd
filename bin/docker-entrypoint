#!/bin/bash -e

# A restarted container must not reuse a pid from the previous process.
rm -f tmp/pids/server.pid

# Gems are installed into the image by `make build`. Container start does not
# run Bundler.

for arg in "$@"; do
  if [ "${arg}" = "rspec" ] || [ "${arg}" = "test" ] || [ "${arg}" = "cucumber" ]; then
    RAILS_ENV=test ./bin/rails db:prepare
    break
  fi

  if [ "${arg}" = "server" ]; then
    ./bin/rails db:prepare
    RAILS_ENV=test ./bin/rails db:prepare
    break
  fi
done

exec "$@"
